# Environment Configuration for Nosana Agents 102 Challenge

# Application Settings
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# MCP Server Configuration
MCP_SERVER_PORT=3001
MCP_SERVER_HOST=localhost

# Agent Configuration
AGENT_PORT=3002
AGENT_HOST=localhost
MCP_SERVER_URL=http://localhost:3001

# Database Configuration (if using)
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# API Keys and Secrets
OPENAI_API_KEY=your_openai_api_key_here
NOSANA_API_KEY=your_nosana_api_key_here

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Feature Flags
ENABLE_SSE=true
ENABLE_WEBSOCKETS=false
ENABLE_CACHING=true
ENABLE_METRICS=true

# IoT Device Configuration
IOT_DEVICE_TIMEOUT=5000
IOT_DEVICE_RETRY_COUNT=3
IOT_DEVICE_HEALTH_CHECK_INTERVAL=30000

# Code Review Configuration
CODE_REVIEW_MAX_FILE_SIZE=10485760
CODE_REVIEW_TIMEOUT=30000
CODE_REVIEW_CONCURRENT_LIMIT=5

# Development Settings
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_LOGS=true
ENABLE_MOCK_DATA=true
